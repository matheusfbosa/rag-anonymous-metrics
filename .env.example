# Copy to .env and edit
RAG_ANON_ANONYMIZER_ENTITIES=PERSON
RAG_ANON_ANONYMIZER_STRATEGY=offline
RAG_ANON_CHUNK_OVERLAP=0
RAG_ANON_CHUNK_SIZE=7000
RAG_ANON_CORPUS=https://raw.githubusercontent.com/NorskRegnesentral/text-anonymization-benchmark/refs/heads/master/echr_{dataset}.json
RAG_ANON_CORPUS_DATASET=test
RAG_ANON_EMBEDDING_MODEL=nomic-embed-text
RAG_ANON_EMBEDDING_NUM_CTX=8192
RAG_ANON_ES_URL=http://localhost:9200
RAG_ANON_LLM_MODEL=qwen3:8b
RAG_ANON_LLM_NUM_CTX=24576
RAG_ANON_LLM_NUM_PREDICT=512
RAG_ANON_LLM_REASONING=false
RAG_ANON_LLM_TEMPERATURE=0.0
RAG_ANON_LLM_TIMEOUT_SEC=180
RAG_ANON_LOG_LEVEL=INFO
RAG_ANON_LOG_LEVEL_HTTP=WARNING
RAG_ANON_LOG_LEVEL_PRESIDIO=ERROR
RAG_ANON_OLLAMA_BASE_URL=http://localhost:11434
RAG_ANON_PRIVACY_PROMPT=true
RAG_ANON_QUERY_QUESTION="In ECHR case 001-83625 (application no. 21865/02 against Turkey), of membership of which illegal organisation was the applicant accused?"
RAG_ANON_RETRIEVAL_K_DOCS=3

RAG_METRICS_CORPUS_DATASET=test
RAG_METRICS_GENERATORS=qwen3:4b-q4_K_M,qwen3:8b,qwen3:14b,qwen3:32b,mistral:7b,qwen3.5:4b,qwen3.8:27b
RAG_METRICS_JUDGES=gemma4:26b,gemma4:12b
RAG_METRICS_JUDGE_MODEL=gemma4:12b
RAG_METRICS_JUDGE_NUM_PREDICT=1536
RAG_METRICS_JUDGE_TIMEOUT_SEC=1800
RAG_METRICS_PRIVACY_PROMPT_GENERATORS=qwen3:4b-q4_K_M,qwen3:32b
RAG_METRICS_QUESTIONS_CATEGORY=benchmark
RAG_METRICS_QUESTIONS_RANGE=all
RAG_METRICS_RESULTS_DIR=./data/output
RAG_METRICS_RETRIEVAL_K_DOCS=3
RAG_METRICS_STRATEGY=offline
# RAG_METRICS_EXPERIMENT_DIR=20260817_091400
# RAG_METRICS_OVERWRITE=0
# RAG_METRICS_SKIP_JUDGE=0
# RAG_METRICS_JUDGE_SOURCE_DIR=20260912_142811
